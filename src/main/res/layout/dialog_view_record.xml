<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDialogFlightId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Flight Details"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E1E24"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        android:layout_marginBottom="12dp">
        
        <WebView
            android:id="@+id/dialogWebView3D"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="#1A1A1D"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvDialogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Details..."
        android:textSize="15sp"
        android:textColor="#424242"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogSharePdf"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="EXPORT &amp; SHARE PDF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#2196F3"
        app:icon="@android:drawable/ic_menu_share"
        app:iconGravity="textStart"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogClose"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CLOSE"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:textColor="#6A6A75"
        app:strokeColor="#E0E0E0"/>

</LinearLayout>